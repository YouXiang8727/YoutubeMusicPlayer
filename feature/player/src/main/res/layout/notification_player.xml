<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_player_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_player_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- 曲目資訊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/notification_player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_player_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 進度：position / progress bar / duration -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/notification_player_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/notification_player_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressTint="#FF3B30"
            android:progressBackgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/notification_player_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 控制列：隨機 / 上一首 / 播放暫停 / 下一首 / 循環 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notification_player_shuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_player_button_bg"
            android:contentDescription="隨機播放"
            android:scaleType="centerInside"
            android:src="@drawable/ic_shuffle" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/notification_player_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_player_button_bg"
            android:contentDescription="上一首"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/notification_player_play"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/notification_player_button_bg"
            android:contentDescription="播放／暫停"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/notification_player_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_player_button_bg"
            android:contentDescription="下一首"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/notification_player_repeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/notification_player_button_bg"
            android:contentDescription="循環模式（清單／單曲）"
            android:scaleType="centerInside"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

</LinearLayout>
